# Supabase - Configure com os dados do seu projeto
# Vá em: https://supabase.com > Seu Projeto > Settings > API
VITE_SUPABASE_URL=https://SUA_URL_AQUI.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_AQUI

# OpenWeatherMap - Para funcionalidades de clima
VITE_OPENWEATHER_KEY=SUA_CHAVE_OPENWEATHER_AQUI
