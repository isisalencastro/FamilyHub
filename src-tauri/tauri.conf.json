{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Family Hub",
  "version": "0.4.0",
  "identifier": "com.familyhub.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Family Hub",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5NTE3ODA1ODhBNTExQ0MKUldUTUVhV0lCWGhSdVMwZTdHUGR3SU9NazRndlQxbmJHcEpMSDl5U3JpeVJ5ZzhYWDF0THNWaXoK",
      "endpoints": [
        "https://SUA_URL_AQUI.supabase.co/storage/v1/object/public/app-updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}